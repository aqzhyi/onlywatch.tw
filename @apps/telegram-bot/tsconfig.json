{
  "extends": "@onlywatch/tsconfigs/strictest_monorepo",
  "compilerOptions": {
    "module": "esnext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "scripts",
    "src/reset.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "*.config.*"
  ],
  "exclude": ["node_modules", "dist"]
}
