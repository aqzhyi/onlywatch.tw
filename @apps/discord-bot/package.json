{
  "private": true,
  "name": "@onlywatch/discord-bot",
  "type": "module",
  "version": "0.1.0",
  "dependencies": {
    "@types/lodash-es": "4.17.12",
    "chinese-conv": "4.0.0",
    "dedent": "1.7.0",
    "discord.js": "14.24.2",
    "dotenv": "17.2.3",
    "lodash-es": "4.17.22",
    "openai": "6.8.1",
    "p-wait-for": "6.0.0",
    "pm2": "6.0.13",
    "tsx": "4.20.6",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@onlywatch/oxlintrc": "workspace:*",
    "@onlywatch/tsconfigs": "workspace:*",
    "@types/node": "22.10.5",
    "oxlint": "1.30.0",
    "prettier": "3.6.2",
    "prettier-plugin-jsdoc": "1.5.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "start": "pm2 start \"tsx src/index.ts\" --watch",
    "dev": "tsx watch src/index.ts",
    "lint": "oxlint .",
    "tsc": "tsc --noEmit",
    "format": "oxlint . --fix --fix-suggestions && prettier --write \"src/**/*.{ts,tsx}\""
  }
}
